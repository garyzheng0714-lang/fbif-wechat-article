# 轮询和定时的时间在 FBIF 中台总账本「定时任务和回调」改，不写在这里
WECHAT_APPID=your_appid_here
WECHAT_SECRET=your_secret_here
# Also accepted for compatibility: WECHAT_APPSECRET, WECHAT_MP_APPID, WECHAT_MP_SECRET
SERVER_PORT=3002
API_KEY=replace_with_random_token

# Official API archive and analytics collector
# ENABLE_OFFICIAL_API_COLLECTOR=1
# OFFICIAL_API_DB_PATH=./data/wechat-official.db
# ANALYTICS_MAX_CALLS_PER_RUN=2000
# CONTENT_MAX_CALLS_PER_RUN=400
# ANALYTICS_BACKFILL_START=2014-12-01
# OFFICIAL_COLLECTOR_INITIAL_DELAY_SECONDS=5

# Automatic layout: 只投文章链接，正文由排版服务自己抓（排版服务只接收链接）
# ENABLE_AUTO_LAYOUT=1
# LAYOUT_OFFICIAL_SYNC_URL=https://fbifmp-layout.foodtalks.cn/api/publish/official-sync
# PUBLISH_SYNC_SERVICE_TOKEN=replace_with_dedicated_layout_service_token
# LAYOUT_SOURCE_NAME=FBIF食品饮料创新
# AUTO_LAYOUT_MAX_DELIVERIES_PER_RUN=20

# Official analytics daily report and watchdog alert. Prefer a chat-scoped
# custom bot; app credentials below remain a compatible fallback.
# OFFICIAL_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace_me
# OFFICIAL_FEISHU_WEBHOOK_SECRET=optional_signing_secret
# OFFICIAL_FEISHU_CHAT_ID=oc_replace_me
# ANALYTICS_DEFERRED_RETRY_MINUTES=30
# ANALYTICS_DEFERRED_MAX_RETRIES=3

# Optional WeChat MASSSENDJOBFINISH callback. Leave disabled until the existing
# official-account server config, auto replies and menus have been migrated safely.
# WECHAT_CALLBACK_TOKEN=replace_with_wechat_callback_token
# WECHAT_CALLBACK_AES_KEY=43_character_encoding_aes_key
# WECHAT_CALLBACK_APP_ID=your_appid_here

# Feishu / Lark credentials
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_BITABLE_APP_TOKEN=your_bitable_app_token_here
# FEISHU_RECORD_BATCH_SIZE=20
# This switch only starts the worker. Every write remains blocked until
# /api/wechat/official/coverage reports verified=true after explicit approval.
# ENABLE_OFFICIAL_BASE_SYNC=1
# OFFICIAL_BASE_SYNC_ROWS_PER_DATASET=500
# OFFICIAL_BASE_SYNC_INITIAL_DELAY_SECONDS=20

# Runtime limits
# GO_MEMORY_LIMIT_MB=512

# WeChat API quota
# Every endpoint has an independent persistent budget. The official ceiling is
# 1000; reserving 200 leaves 800 automatic calls per endpoint per day.
# WECHAT_ENDPOINT_DAILY_QUOTA_LIMIT=1000
# WECHAT_ENDPOINT_DAILY_QUOTA_RESERVE=200
# WECHAT_ENDPOINT_DAILY_QUOTA_RESERVE_PERCENT=20
# WECHAT_QUOTA_FILE=./data/wechat-endpoint-quota.json

# Retired direct sync. It is fail-closed in code and must remain disabled.
# ENABLE_FEISHU_SYNC=0
