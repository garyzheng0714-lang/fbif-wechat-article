WECHAT_APPID=your_appid_here
WECHAT_SECRET=your_secret_here
# Also accepted for compatibility: WECHAT_APPSECRET, WECHAT_MP_APPID, WECHAT_MP_SECRET
SERVER_PORT=3002
API_KEY=replace_with_random_token

# Official API archive and analytics collector
# ENABLE_OFFICIAL_API_COLLECTOR=1
# OFFICIAL_API_DB_PATH=./data/wechat-official.db
# ANALYTICS_MAX_CALLS_PER_RUN=500
# CONTENT_MAX_CALLS_PER_RUN=80
# ANALYTICS_BACKFILL_START=2014-12-01
# OFFICIAL_COLLECTOR_INITIAL_DELAY_SECONDS=5

# Automatic layout from official freepublish content only
# ENABLE_AUTO_LAYOUT=1
# LAYOUT_OFFICIAL_SYNC_URL=https://fbifmp-layout.foodtalks.cn/api/publish/official-sync
# LAYOUT_ADMIN_PASSWORD=replace_with_layout_admin_password
# LAYOUT_SOURCE_NAME=FBIF食品饮料创新
# AUTO_LAYOUT_POLL_INTERVAL_MINUTES=15
# AUTO_LAYOUT_MAX_DELIVERIES_PER_RUN=20

# Feishu / Lark credentials
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
FEISHU_BITABLE_APP_TOKEN=your_bitable_app_token_here
# FEISHU_RECORD_BATCH_SIZE=20

# Runtime limits
# GO_MEMORY_LIMIT_MB=512

# WeChat API quota
# WECHAT_DAILY_QUOTA_LIMIT=1500
# WECHAT_DAILY_QUOTA_RESERVE=100

# Published article sync
# ENABLE_FEISHU_SYNC=1
# WECHAT_PUBLISHED_PAGE_SIZE=20
# WECHAT_PUBLISHED_RECENT_PAGES=3
# WECHAT_PUBLISHED_BACKFILL_GROW_PAGES=5

# Optional: enable inline cover/image enrichment in the same sync pass.
# Keep disabled by default for maximum stability.
# WECHAT_SYNC_COVER_INLINE=0
# WECHAT_SYNC_BODY_IMAGES_INLINE=0

# Optional: background media worker for OSS cover/image enrichment.
# ENABLE_MEDIA_WORKER=1
# MEDIA_WORKER_BATCH_SIZE=10
# MEDIA_WORKER_CONCURRENCY=2
# MEDIA_WORKER_INITIAL_DELAY_SECONDS=60
# MEDIA_WORKER_INTERVAL_MINUTES=30

# Optional: background history worker for old material/news backfill.
# ENABLE_HISTORY_WORKER=1
# HISTORY_WORKER_INITIAL_DELAY_SECONDS=20
# HISTORY_WORKER_INTERVAL_MINUTES=120
# MATERIAL_HISTORY_PAGE_SIZE=20
# MATERIAL_HISTORY_MAX_CALLS_PER_RUN=400
# HISTORY_WORKER_WRITE_PAUSE_MS=500

# Optional: Aliyun OSS for public media URLs
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your_bucket_name
# OSS_REGION=cn-shanghai
# OSS_BUCKET_DOMAIN=your_bucket.oss-cn-shanghai.aliyuncs.com
